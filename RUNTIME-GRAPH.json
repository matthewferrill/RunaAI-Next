{
 "schemaVersion": "runalab-runtime-graph/v1",
 "note": "Hand-authored model of the assembled base as the probes exercise it, plus installed components the probes bypass (status marks which). Every node, edge, and durable write is a coverage object. 'trust' names what crosses: model output, tool results, retrieved text, and document content are untrusted data entering trusted code.",
 "nodes": [
  { "id": "harness", "desc": "probe runner process (stand-in for Runa's caller)", "status": "exercised" },
  { "id": "orchestration", "desc": "central Mastra object: DI, registration, lifecycle", "status": "installed-bypassed — probes construct components directly; the real migration path would use it" },
  { "id": "agent", "desc": "@mastra/core Agent loop", "status": "exercised" },
  { "id": "model-endpoint", "desc": "LM Studio chat completions (RUNA-HOME, OpenAI-compatible)", "status": "exercised", "external": true },
  { "id": "embed-endpoint", "desc": "LM Studio embeddings (same host)", "status": "exercised", "external": true },
  { "id": "memory", "desc": "@mastra/memory (4 configs)", "status": "exercised" },
  { "id": "memory-store", "desc": "LibSQLStore per-case db file", "status": "exercised", "durable": true },
  { "id": "memory-vector", "desc": "LibSQLVector for semanticRecall", "status": "exercised", "durable": true },
  { "id": "vector-index", "desc": "LibSQLVector retrieval corpora", "status": "exercised", "durable": true },
  { "id": "rag-pipeline", "desc": "@mastra/rag parse/chunk/process pipeline", "status": "installed-unexercised" },
  { "id": "tool-layer", "desc": "agent tool wrapper + tool schemas", "status": "exercised (MCP path only; native tools unexercised)" },
  { "id": "mcp-client", "desc": "@mastra/mcp MCPClient", "status": "exercised" },
  { "id": "mcp-server", "desc": "stdio child process (@modelcontextprotocol/server-filesystem)", "status": "exercised", "external": true },
  { "id": "sandbox-fs", "desc": "filesystem the MCP server reads/writes", "status": "exercised", "durable": true },
  { "id": "workflow", "desc": "@mastra/core workflows (suspend/resume path)", "status": "exercised (evented + durable-agent variants unexercised)" },
  { "id": "snapshot-store", "desc": "LibSQLStore workflow snapshots", "status": "exercised", "durable": true },
  { "id": "effect-target", "desc": "the governed effect a workflow step performs", "status": "exercised", "durable": true },
  { "id": "evals", "desc": "@mastra/evals scorers", "status": "open harness gap" },
  { "id": "processors", "desc": "@mastra/core input/output processors", "status": "installed-unexercised" },
  { "id": "observability", "desc": "@mastra/core observability/telemetry", "status": "installed-unexercised" },
  { "id": "stores-on-disk", "desc": "all libsql files as artifacts an actor with disk access can touch", "status": "exercised (tamper probe 048)", "durable": true }
 ],
 "edges": [
  { "id": "E01", "from": "harness", "to": "agent", "trust": "same-process" },
  { "id": "E02", "from": "agent", "to": "model-endpoint", "network": true, "trust": "model output is untrusted input to the loop" },
  { "id": "E03", "from": "agent", "to": "memory", "trust": "same-process" },
  { "id": "E04", "from": "memory", "to": "memory-store", "durableWrite": true },
  { "id": "E05", "from": "memory", "to": "memory-vector", "durableWrite": true },
  { "id": "E06", "from": "memory", "to": "embed-endpoint", "network": true },
  { "id": "E07", "from": "harness", "to": "vector-index", "durableWrite": true, "note": "retrieval probes call the store directly; the rag-pipeline path is unexercised" },
  { "id": "E08", "from": "harness", "to": "embed-endpoint", "network": true },
  { "id": "E09", "from": "vector-index", "to": "agent", "trust": "retrieved text is untrusted content entering the prompt", "dataFlow": true },
  { "id": "E10", "from": "memory", "to": "agent", "trust": "recalled memory is stored, previously-untrusted content re-entering the prompt", "dataFlow": true },
  { "id": "E11", "from": "agent", "to": "tool-layer", "trust": "same-process; tool DESCRIPTIONS also flow to the model here" },
  { "id": "E12", "from": "tool-layer", "to": "mcp-client", "trust": "same-process" },
  { "id": "E13", "from": "mcp-client", "to": "mcp-server", "processBoundary": true, "trust": "server code and its results are outside the harness process" },
  { "id": "E14", "from": "mcp-server", "to": "sandbox-fs", "durableWrite": true, "effect": true },
  { "id": "E15", "from": "mcp-server", "to": "agent", "trust": "tool results are untrusted input to the loop", "dataFlow": true },
  { "id": "E16", "from": "harness", "to": "workflow", "trust": "same-process" },
  { "id": "E17", "from": "workflow", "to": "snapshot-store", "durableWrite": true },
  { "id": "E18", "from": "workflow", "to": "effect-target", "durableWrite": true, "effect": true, "authority": "the approval-to-effect binding lives on this edge" },
  { "id": "E19", "from": "snapshot-store", "to": "workflow", "trust": "resume reads the snapshot as authoritative state — tamper probe 048 lives here", "dataFlow": true },
  { "id": "E20", "from": "harness", "to": "evals" },
  { "id": "E21", "from": "processors", "to": "agent", "note": "visibility of memory/retrieved/tool material to processors is itself the open question", "dataFlow": true },
  { "id": "E22", "from": "orchestration", "to": "agent", "note": "unexercised assembled path" },
  { "id": "E23", "from": "agent", "to": "observability", "dataFlow": true, "note": "what lands in traces, including secrets and authority material" },
  { "id": "E24", "from": "stores-on-disk", "to": "workflow", "trust": "disk-level actor writes become runtime state", "dataFlow": true }
 ]
}
