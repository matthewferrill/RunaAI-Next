    {
      "id": "restart-after-commit",
      "lane": "all",
      "domain": "durability",
      "input": "Resume after answer commit but before client delivery.",
      "fixture": "fresh process and existing checkpoint",
      "expect": ["committed-response-returned", "completed-node-not-replayed", "provider-not-recalled", "same-requestId"]
