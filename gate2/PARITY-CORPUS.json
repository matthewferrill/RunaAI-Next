      "fixture": "per-role context ceilings with required identity and safety reserves",
      "expect": ["role-ceiling-used", "required-context-retained", "omissions-reported", "no-silent-empty-wrapper", "effects-empty"]
    },
    {
      "id": "deterministic-lane-and-role-routing",
      "lane": "all",
      "domain": "routing",
      "input": "Equivalent requests submitted through each registered lane.",
