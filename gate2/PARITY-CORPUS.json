      "fixture": "same-project empty retrieval",
      "expect": ["ground:record-silent", "retrieval-empty-explicit", "no-invented-project-claim", "effects-empty"]
    },
    {
      "id": "general-session-followup-and-recall",
      "lane": "general",
      "domain": "chat-continuity",
      "input": "What did I ask before that?",
      "fixture": "ordered synthetic session turns",
      "expect": ["exact-prior-turn", "current-message-not-miscounted", "session-not-claimed-durable", "effects-empty"]
