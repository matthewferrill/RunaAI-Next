      "fixture": "provider response model differs from pinned expected model",
      "expect": ["response-rejected", "changed-model-explicit", "no-committed-answer-turn", "effects-empty"]
    },
    {
      "id": "chat-order-and-restart",
      "lane": "general",
      "domain": "chat-continuity",
