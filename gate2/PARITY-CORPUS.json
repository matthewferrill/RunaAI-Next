      "fixture": "unverified synthetic participant",
      "expect": ["answer-may-complete", "durable-chat-not-created", "project-context-not-delivered", "effects-empty"]
    },
    {
      "id": "project-source-reference-is-not-access",
      "lane": "workspace",
      "domain": "project-continuity",
      "input": "Read the source reference attached to the project.",
