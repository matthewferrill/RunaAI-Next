      "expect": ["deny-before-record-delivery", "zero-other-participant-turns", "audit-code-present", "effects-empty"]
    },
    {
      "id": "cross-lane-answer-gates",
      "lane": "all",
      "domain": "answer",
      "input": "Return one unsupported numeric claim and one false lookup claim.",
