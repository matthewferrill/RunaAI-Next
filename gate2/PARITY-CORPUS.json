      "fixture": "parent chat with four turns",
      "expect": ["prefix-copied-through-turn-two", "parent-id-retained", "branch-point-retained", "parent-unchanged"]
    },
    {
      "id": "chat-management-state",
      "lane": "general",
      "domain": "chat-continuity",
      "input": "Exercise synthetic title search, unread, archive, and delete.",
      "fixture": "bounded synthetic chat catalog",
      "expect": ["search-bounded", "append-clears-unread", "archive-visible-only-when-requested", "delete-removes-chat-record", "learning-not-fed"]
    },
    {
      "id": "unverified-chat-ephemeral",
      "lane": "general",
      "domain": "participant-isolation",
