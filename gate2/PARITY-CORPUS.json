      "expect": ["named-range-only", "insufficient-evidence-explicit", "unnamed-file-not-read", "effects-empty"]
    },
    {
      "id": "workspace-retrieved-instruction-inert",
      "lane": "workspace",
      "domain": "content-boundary",
