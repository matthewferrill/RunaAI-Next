{
  "schemaVersion": "runaai-public-git-network-policy/v1",
  "policyId": "m1-s2b1-public-git-network-v1",
  "allowedScheme": "https",
  "allowedPort": 443,
  "allowedMethods": ["GET", "POST"],
  "maximumDnsAnswers": 16,
  "dnsTimeoutMs": 3000,
  "maximumConnections": 2,
  "connectionIdleTimeoutMs": 10000,
  "absoluteDeadlineMs": 120000,
  "maximumRequestHeaderBytes": 16384,
  "maximumResponseHeaderBytes": 32768,
  "maximumRequestBodyBytes": 2097152,
  "maximumResponseBodyBytes": 100663296,
  "maximumFrameBytes": 1048576,
  "maximumFramesPerDirection": 128,
  "denyIpv4Cidrs": [
    "0.0.0.0/8",
    "10.0.0.0/8",
    "100.64.0.0/10",
    "127.0.0.0/8",
    "169.254.0.0/16",
    "172.16.0.0/12",
    "192.0.0.0/24",
    "192.0.2.0/24",
    "192.88.99.0/24",
    "192.168.0.0/16",
    "198.18.0.0/15",
    "198.51.100.0/24",
    "203.0.113.0/24",
    "224.0.0.0/4",
    "240.0.0.0/4"
  ],
  "denyIpv6Cidrs": [
    "::/128",
    "::1/128",
    "::ffff:0:0/96",
    "64:ff9b::/96",
    "100::/64",
    "2001::/23",
    "2001:db8::/32",
    "2002::/16",
    "fc00::/7",
    "fe80::/10",
    "fec0::/10",
    "ff00::/8"
  ],
  "explicitMetadataAddresses": ["169.254.169.254", "fd00:ec2::254"],
  "redirectsAllowed": false,
  "proxyEnvironmentAllowed": false
}
